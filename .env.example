# LLM Provider
LLM_PROVIDER=venus
# Venus LLM Proxy（兼容 OpenAI API 格式）
ENV_VENUS_OPENAPI_SECRET_ID=你的token
VENUS_LLM_PROXY_URL=http://v2.open.venus.oa.com/llmproxy
VENUS_LLM_MODEL=gpt-4o-2024-11-20
# 备用模型：主模型 transport/服务错误时自动降级；model 留空则禁用降级
FALLBACK_VENUS_LLM_PROXY_URL=
FALLBACK_VENUS_LLM_MODEL=

# 上下文预算（不得超过实际模型窗口，否则超长 prompt 只会得到笼统的 400）
LLM_CONTEXT_TOKENS=131072
LLM_MAX_OUTPUT_TOKENS=8192              # 准入时预留的输出下限，不是上限

# OpenAI（备用 provider）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# 论文源 API Keys / Polite Pool 邮箱
# 核心源（arXiv/Crossref/S2）无需 key 即可用；OpenAlex 无 key 有 $0.10/天预算
SEMANTIC_SCHOLAR_API_KEY=
# 免费申请: https://www.semanticscholar.org/product/api#api-key-form （有 key 5000 req/min，无 key 100 req/5min）
OPENALEX_EMAIL=research@deep.local
# 可选，免费注册: https://openalex.org （有 key $1/天预算，无 key $0.10/天）
OPENALEX_API_KEY=
CROSSREF_EMAIL=research@deep.local
# 以下两个源需付费/订购 key，留空则自动跳过
IEEE_API_KEY=
CORE_API_KEY=

# Agent 参数
MAX_ROUNDS=5
QUERIES_PER_ROUND=5
PAPERS_PER_SOURCE_PER_QUERY=15
HIGH_PRIORITY_TARGET=15

# 并发限制（P0-1: 防止 SQLite 写冲突）
MAX_CONCURRENT_AGENTS=2

# RAG / PDF 下载
# Sci-Hub 默认禁用（法律合规），设为 true 启用
ENABLE_SCIHUB=false

# 证据抽取
# 每轮抽取论文数上限。已废弃：抽取现在无条件覆盖全部候选论文，本项仅为兼容旧配置保留
EVIDENCE_MAX_PAPERS=15
# 每批论文数。已废弃：改为单一共享并发池后不再分批
EVIDENCE_BATCH_SIZE=4
# 抽取并发：同时在跑的论文数。全量覆盖的成本由它决定
# 每篇在飞 = 1 个 PDF 常驻内存 + EVIDENCE_CHUNK_CONCURRENCY 路并发 LLM 调用，
# 调高会同时放大内存与对外并发
EVIDENCE_EXTRACT_CONCURRENCY=4

# PDF 预热：抽取开始前先批量拉取本轮 PDF，而非边抽边下。
# 下载是网络受限且可恢复的（限流窗口重试即成功），抽取是 LLM 受限且昂贵的；
# 两者交织会让可恢复的网络故障固化成证据永久丢失，且单轮耗时不预测。
ENABLE_PDF_PREWARM=true
# 预热并发。刻意低于抽取期并发：预热时没有其他负载，而 arXiv 约 3 req/s 即限流，
# 调高不会抢回任何东西，只会触发重试逻辑本就要吸收的 429。
PDF_PREWARM_CONCURRENCY=3

# 评分权重（P1-7: authority 权重提升）
# SCORE_WEIGHT_RELEVANCE=0.25
# SCORE_WEIGHT_AUTHORITY=0.30
# SCORE_WEIGHT_RECENCY=0.15
# SCORE_WEIGHT_NOVELTY=0.15
# SCORE_WEIGHT_IDEA_POTENTIAL=0.15

# Gap 挖掘 v7.2（pilot 裁决 2026-10-29 的准入收紧）
# scaling_regime 候选在准入时做 claim 级先例检索（对抗查询→检索→保守判定）；
# 命中已测范围则拒 SCALING_RANGE_ALREADY_MEASURED，检索基础设施故障只记 trace 不拒（fail-open）
GAP_MINING_PRECEDENT_CHECK_ENABLED=true
# 先例检索每候选送判的论文数上限
GAP_MINING_PRECEDENT_CHECK_TOP_K=5

# 覆盖度增量匹配（探针 df744606，2026-10-30）：只把上一覆盖快照之后新建的证据送 LLM 匹配，
# 已判定的 (question, evidence) pair 从既有 link 原样重放；false 恢复每轮全量重匹配
COVERAGE_INCREMENTAL_MATCHING=true

# 候选饥饿控制（探针 0ae1a146）：每轮 gap 竞争都会把落选候选 deferred；
# 达到此次数即转 rejected（显式终态，不再伪装成"待审计"）。0 = 只保留饥饿加权、不退休
GAP_STARVATION_DEFERRAL_LIMIT=3

# Idea 分数线（2026-10-31 全库校准分析，595 个带分数 Idea / 94 任务）
# 0.70 原本硬编码在三处，且只校准于 v3–v7 分布（median 0.711，61.3% 过线）；
# v7.2 的 median 是 0.654（12.5% 过线），4 个 executable_candidate 全部不过线。
# 数值维持 0.70：下调属"绝对质量门槛 vs 组内相对排序"的政策决策，不随重构变动。
# 若要重新校准，先跑 scripts/idea_score_distribution.py 看当前分布。
IDEA_SCORE_GO_LINE=0.70
IDEA_SCORE_REVISE_LINE=0.50

# 数据库
DATABASE_URL=sqlite:///./deep_research.db

# 服务
HOST=0.0.0.0
PORT=8000

# 认证（P0-4：留空则禁用认证；生产环境务必设置）
# 设置后，POST/PUT/DELETE /api/tasks 请求需携带 X-API-Key 头
API_KEY=
