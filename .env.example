# LLM Provider
LLM_PROVIDER=venus
# Venus LLM Proxy（兼容 OpenAI API 格式）
ENV_VENUS_OPENAPI_SECRET_ID=你的token
VENUS_LLM_PROXY_URL=http://v2.open.venus.oa.com/llmproxy
VENUS_LLM_MODEL=gpt-4o-2024-11-20

# OpenAI（备用 provider）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# 论文源 API Keys（可选，无 key 时走免费额度）
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_EMAIL=research@deep.local
IEEE_API_KEY=w87t98c2megvf27e6tfen4sx
CORE_API_KEY=kWMQsZSNe0cChVb2PrYgLUT1qal4Hp8E

# Agent 参数
MAX_ROUNDS=5
QUERIES_PER_ROUND=5
PAPERS_PER_SOURCE_PER_QUERY=15
HIGH_PRIORITY_TARGET=15

# 并发限制（P0-1: 防止 SQLite 写冲突）
MAX_CONCURRENT_AGENTS=2

# RAG / PDF 下载
# Sci-Hub 默认禁用（法律合规），设为 true 启用
ENABLE_SCIHUB=false

# 评分权重（P1-7: authority 权重提升）
# SCORE_WEIGHT_RELEVANCE=0.25
# SCORE_WEIGHT_AUTHORITY=0.30
# SCORE_WEIGHT_RECENCY=0.15
# SCORE_WEIGHT_NOVELTY=0.15
# SCORE_WEIGHT_IDEA_POTENTIAL=0.15

# 数据库
DATABASE_URL=sqlite:///./deep_research.db

# 服务
HOST=0.0.0.0
PORT=8000

# 认证（P0-4：留空则禁用认证；生产环境务必设置）
# 设置后，POST/PUT/DELETE /api/tasks 请求需携带 X-API-Key 头
API_KEY=
